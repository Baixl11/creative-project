{
  "version": "0.1.0",
  "entry": {
    "mode": "codex_skill_conversation",
    "projectSkill": ".agents/skills/{{REQUEST_SKILL_NAME}}",
    "sharedContextRoot": ".harness/tasks",
    "taskPathPattern": ".harness/tasks/<YYYY-MM-DD>/<type>/<short-slug>",
    "environment": ".harness/environment.yaml",
    "workspaceMap": ".harness/workspace-map.yaml"
  },
  "workflow": {
    "orchestrator": "current_codex_session",
    "bootstrapMode": "{{BOOTSTRAP_MODE}}",
    "stageOrder": ["planner", "coder", "verifier", "doc_gardener"],
    "taskCreation": "skill_template",
    "taskRouting": {
      "reference": ".agents/skills/{{REQUEST_SKILL_NAME}}/references/task-routing.md",
      "currentTask": ".harness/current-task.json",
      "taskIndex": ".harness/tasks/index.json",
      "routeBeforeCreate": true,
      "supportedIntents": [
        "new_request",
        "continue_previous",
        "continue_named_task",
        "acceptance_feedback"
      ],
      "ambiguityPolicy": "ask_one_confirmation_question"
    },
    "workspaceDiscovery": {
      "workspaceMap": ".harness/workspace-map.yaml",
      "root": "{{WORKSPACE_ROOT}}",
      "targetProject": "{{WORKSPACE_TARGET_PROJECT}}",
      "relatedProjects": {{RELATED_PROJECTS_JSON}},
      "commandGraph": {{COMMAND_GRAPH_JSON}},
      "readRelatedProjectsWhenCommandsReferenceThem": true,
      "editBoundarySignal": ".harness directory",
      "harnessedRelatedProjectPolicy": "ask_before_write",
      "affiliatedSubrepoPolicy": "allowed_by_default",
      "sameTaskBranchForAffiliatedSubrepos": true
    },
    "problemDecomposition": {
      "reference": ".agents/skills/{{REQUEST_SKILL_NAME}}/references/problem-decomposition.md",
      "requiredBeforeCoding": true,
      "requiredArtifacts": [
        "problem-decomposition.md",
        "acceptance-criteria.md"
      ],
      "readyGate": "problem definition, selected solution, work breakdown, and acceptance split are complete"
    },
    "researchProtocol": {
      "reference": ".agents/skills/{{REQUEST_SKILL_NAME}}/references/research-protocol.md",
      "requiredWhenUnclear": true,
      "artifact": "research-notes.md",
      "readyGate": "unclear requirements or uncertain solutions have local evidence, optional external sources, project-fit analysis, and selected approach recorded"
    },
    "runtimeVerification": {
      "reference": ".agents/skills/{{REQUEST_SKILL_NAME}}/references/runtime-verification.md",
      "requiredWhenBehaviorChanges": true,
      "artifact": "runtime-test-plan.md",
      "buildOnlyIsInsufficientForBehavior": true,
      "electronDefaultTool": "mcp_playwright_or_playwright",
      "fallbackPolicy": "ask_user_before_manual_checks_or_project_native_test_scripts"
    },
    "functionalVerification": {
      "reference": ".agents/skills/{{REQUEST_SKILL_NAME}}/references/functional-verification.md",
      "requiredWhenBehaviorOrCoreFlowChanges": true,
      "artifact": "functional-test-plan.md",
      "requiredBeforeRuntime": true,
      "hardGate": "functional_checks for blocking/high feature points must pass before runtime, interaction, or human review"
    },
    "interactionVerification": {
      "reference": ".agents/skills/{{REQUEST_SKILL_NAME}}/references/interaction-verification.md",
      "environment": ".harness/environment.yaml",
      "requiredForFrontendBehavior": true,
      "artifact": "interaction-test-plan.yaml",
      "preferredTool": "mcp_playwright",
      "hardGate": "interaction evidence or user-confirmed fallback is required before human review"
    },
    "uncertaintyGates": {
      "reference": ".agents/skills/{{REQUEST_SKILL_NAME}}/references/uncertainty-gates.md",
      "pauseOnHighImpactUnknowns": true,
      "blockedStatuses": ["needs_clarification", "blocked_on_decision"],
      "maxQuestions": 3,
      "appliesTo": [
        "initialization_analysis",
        "requirement_analysis",
        "problem_decomposition",
        "environment_configuration",
        "verification_selection",
        "data_security_dependency_git_decisions",
        "visual_acceptance"
      ]
    },
    "observability": {
      "reference": ".agents/skills/{{REQUEST_SKILL_NAME}}/references/task-observability.md",
      "stateEntry": "state.json",
      "eventStream": "events.ndjson",
      "machineArtifacts": [
        "summary.md",
        "state.json",
        "events.ndjson",
        "agents.json",
        "artifacts.json",
        "validations.json"
      ],
      "publicOnly": true
    },
    "conditionalProfiles": {
      "screenshotUi": {
        "reference": ".agents/skills/{{REQUEST_SKILL_NAME}}/references/visual-task-profile.md",
        "requiredArtifacts": [
          "visual-spec.md",
          "visual-checklist.md",
          "visual-review.md",
          "visual-defects.md",
          "snapshots/"
        ],
        "requiredLoop": "screenshot, region diff, defect logging, repair, re-screenshot, recheck",
        "scaleRequired": true,
        "readyGate": "reference-vs-actual review completed, scaling checked, and no open blocking or major visual defects"
      }
    },
    "subagents": "disabled_by_default",
    "gitLifecycle": {
      "enabledWhenGitRepo": true,
      "branchPattern": "harness/<type>/<short-slug>",
      "createOrSwitchBeforeCoding": true,
      "sameBranchForEditableAffiliatedSubrepos": true,
      "commitPolicy": "commit after safe module, risk-boundary, or 300-500 line change boundaries",
      "pushPolicy": "never_without_explicit_user_request"
    }
  },
  "sensors": {
    "harness": {{HARNESS_SENSORS_JSON}},
    "native": {{NATIVE_SENSORS_JSON}}
  },
  "snapshotIgnore": {{SNAPSHOT_IGNORE_JSON}}
}
